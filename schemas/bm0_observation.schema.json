{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/bm0_observation.schema.json",
  "title": "B2 BM0 Observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "contract_version",
    "attempt_id",
    "trial_id",
    "provider_subject_id",
    "model_subject_id",
    "requested_model_id",
    "resolved_model_or_version_id",
    "identity_certainty",
    "alias_limitation",
    "provider_request_id",
    "endpoint_id",
    "capability_mode",
    "system_wrapper_version",
    "developer_wrapper_version",
    "sampling_controls_fingerprint",
    "reasoning_controls_fingerprint",
    "target_id",
    "target_class",
    "applicability_result",
    "entry_id",
    "family_id",
    "case_id",
    "variant_id",
    "mechanism_lineage_id",
    "case_fingerprint",
    "generator_or_mutation_version",
    "contamination_status",
    "exposure_status",
    "corpus_item_alias",
    "replicate_index",
    "prompt_fingerprint",
    "context_fingerprint",
    "tool_schema_fingerprint",
    "sandbox_fingerprint",
    "state_machine_fingerprint",
    "timestamps",
    "raw_response_fingerprint",
    "scorer_id",
    "scorer_version",
    "scorer_fingerprint",
    "oracle_id",
    "oracle_version",
    "oracle_fingerprint",
    "evidence_receipt_fingerprint",
    "usage",
    "latency",
    "cost",
    "provider_terminal_status",
    "provider_http_status",
    "terminal_status",
    "model_failure_value",
    "system_invariant_failure_value",
    "evidence_complete",
    "hard_invariant_pass",
    "adjudication_status",
    "observation_fingerprint"
  ],
  "properties": {
    "schema_version": {
      "const": "b2-bm0-observation/v1"
    },
    "benchmark_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@+\\-/]{0,191}$"
    },
    "contract_version": {
      "const": "v0.2"
    },
    "attempt_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@+\\-/]{0,191}$"
    },
    "trial_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@+\\-/]{0,191}$"
    },
    "provider_subject_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@+\\-/]{0,191}$"
    },
    "model_subject_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@+\\-/]{0,191}$"
    },
    "requested_model_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@+\\-/]{0,191}$"
    },
    "resolved_model_or_version_id": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@+\\-/]{0,191}$"
        }
      ]
    },
    "identity_certainty": {
      "enum": [
        "EXACT",
        "ALIAS_ONLY",
        "UNKNOWN",
        "SYSTEM_SCOPE"
      ]
    },
    "alias_limitation": {
      "enum": [
        "NONE",
        "MOVING_ALIAS_RESOLUTION_REQUIRED",
        "UNVERIFIABLE_ALIAS_DISCLOSED",
        "NOT_APPLICABLE_SYSTEM_SCOPE"
      ]
    },
    "provider_request_id": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@+\\-/]{0,191}$"
        }
      ]
    },
    "endpoint_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@+\\-/]{0,191}$"
    },
    "capability_mode": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@+\\-/]{0,191}$"
    },
    "system_wrapper_version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@+\\-/]{0,191}$"
    },
    "developer_wrapper_version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@+\\-/]{0,191}$"
    },
    "sampling_controls_fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "reasoning_controls_fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "target_id": {
      "enum": [
        "BM0-TUT-E01-QA0-ENTITY-ATTRIBUTE-BINDING",
        "BM0-TUT-E02-QA0-CONNECTOR-SCHEMA",
        "BM0-TUT-E03-QA0-INTEGRITY-COMPLETENESS",
        "BM0-TUT-E04-QA0-EVIDENCE-SCOPE",
        "BM0-TUT-E05-QA1G-ENTITY-ATTRIBUTE-BINDING",
        "BM0-TUT-E06-QA1G-INVENTORY-EVIDENCE-SCOPE",
        "BM0-TUT-E07-QA1G-SOURCE-MODALITY",
        "BM0-TUT-E08-QA1T-CONNECTOR-SCHEMA-RETRY",
        "BM0-TUT-E09-QA1T-CAPABILITY-ROUTING",
        "BM0-TUT-E10-QA1T-DESTRUCTIVE-WRITE-RECOVERY",
        "BM0-TUT-E11-QA2-CONSTRAINT-ACTION-PERSISTENCE",
        "BM0-TUT-E12-QA2-LIVE-ASSESSMENT-RULE-PERSISTENCE",
        "BM0-TUT-E13-QA2-LIVE-PRODUCTION-NO-AI-PERSISTENCE",
        "BM0-TUT-E14-QA3-FULL-SET-PROJECTION-COMPLETENESS",
        "BM0-TUT-E15-QA3-METRIC-ATTRIBUTION-PROVENANCE-SEPARATION",
        "BM0-TUT-E16-QA3-DASHBOARD-FIELD-SEMANTICS-SCOPE-LOCK"
      ]
    },
    "target_class": {
      "enum": [
        "MODEL_DIRECT",
        "MODEL_CONTEXT_GROUNDED",
        "AGENT_STANDARDIZED",
        "SYSTEM_EVAL_ONLY"
      ]
    },
    "entry_id": {
      "enum": [
        "E01",
        "E02",
        "E03",
        "E04",
        "E05",
        "E06",
        "E07",
        "E08",
        "E09",
        "E10",
        "E11",
        "E12",
        "E13",
        "E14",
        "E15",
        "E16"
      ]
    },
    "family_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@+\\-/]{0,191}$"
    },
    "case_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@+\\-/]{0,191}$"
    },
    "variant_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@+\\-/]{0,191}$"
    },
    "mechanism_lineage_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@+\\-/]{0,191}$"
    },
    "case_fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "generator_or_mutation_version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@+\\-/]{0,191}$"
    },
    "contamination_status": {
      "enum": [
        "ASSESSED_CLEAR",
        "KNOWN_EXPOSED",
        "UNKNOWN"
      ]
    },
    "exposure_status": {
      "enum": [
        "PUBLICLY_DISCLOSED_REGRESSION",
        "PUBLICLY_DISCLOSED_MUTATION",
        "PUBLICLY_DISCLOSED_CONTROL",
        "PRIVATE_UNEXPOSED_BEFORE_MANIFEST_FREEZE"
      ]
    },
    "corpus_item_alias": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@+\\-/]{0,191}$"
    },
    "replicate_index": {
      "type": "integer",
      "minimum": 0
    },
    "prompt_fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "context_fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "tool_schema_fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "sandbox_fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "state_machine_fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "timestamps": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_started_at",
        "response_completed_at"
      ],
      "properties": {
        "request_started_at": {
          "type": "string",
          "format": "date-time"
        },
        "response_completed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "raw_response_fingerprint": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      ]
    },
    "scorer_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@+\\-/]{0,191}$"
    },
    "scorer_version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@+\\-/]{0,191}$"
    },
    "scorer_fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "oracle_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@+\\-/]{0,191}$"
    },
    "oracle_version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@+\\-/]{0,191}$"
    },
    "oracle_fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "evidence_receipt_fingerprint": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      ]
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attribution_status",
        "input_tokens",
        "output_tokens",
        "total_tokens"
      ],
      "properties": {
        "attribution_status": {
          "enum": [
            "ATTRIBUTABLE",
            "UNAVAILABLE",
            "NOT_APPLICABLE"
          ]
        },
        "input_tokens": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 0
            }
          ]
        },
        "output_tokens": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 0
            }
          ]
        },
        "total_tokens": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 0
            }
          ]
        }
      }
    },
    "latency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attribution_status",
        "milliseconds"
      ],
      "properties": {
        "attribution_status": {
          "enum": [
            "ATTRIBUTABLE",
            "UNAVAILABLE",
            "NOT_APPLICABLE"
          ]
        },
        "milliseconds": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "number",
              "minimum": 0
            }
          ]
        }
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attribution_status",
        "currency",
        "amount",
        "pricing_source_fingerprint"
      ],
      "properties": {
        "attribution_status": {
          "enum": [
            "ATTRIBUTABLE",
            "UNAVAILABLE",
            "NOT_APPLICABLE"
          ]
        },
        "currency": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "amount": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "number",
              "minimum": 0
            }
          ]
        },
        "pricing_source_fingerprint": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          ]
        }
      }
    },
    "provider_terminal_status": {
      "enum": [
        "SUCCESS",
        "PROVIDER_ERROR",
        "NETWORK_ERROR",
        "SCHEMA_ERROR",
        "RUNTIME_ERROR",
        "NOT_APPLICABLE"
      ]
    },
    "provider_http_status": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        }
      ]
    },
    "terminal_status": {
      "enum": [
        "PASS",
        "FAIL",
        "NOT_EVALUABLE",
        "BLOCKED",
        "ERROR",
        "UNKNOWN"
      ]
    },
    "model_failure_value": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "integer",
          "enum": [
            0,
            1
          ]
        }
      ]
    },
    "system_invariant_failure_value": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "integer",
          "enum": [
            0,
            1
          ]
        }
      ]
    },
    "evidence_complete": {
      "type": "boolean"
    },
    "hard_invariant_pass": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        }
      ]
    },
    "adjudication_status": {
      "enum": [
        "NOT_REQUIRED",
        "RESOLVED",
        "UNRESOLVED",
        "ERROR"
      ]
    },
    "observation_fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "applicability_result": {
      "enum": [
        "APPLICABLE",
        "NOT_APPLICABLE"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "target_class": {
            "const": "MODEL_DIRECT"
          }
        },
        "required": [
          "target_class"
        ]
      },
      "then": {
        "properties": {
          "target_id": {
            "enum": [
              "BM0-TUT-E11-QA2-CONSTRAINT-ACTION-PERSISTENCE",
              "BM0-TUT-E12-QA2-LIVE-ASSESSMENT-RULE-PERSISTENCE",
              "BM0-TUT-E13-QA2-LIVE-PRODUCTION-NO-AI-PERSISTENCE"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "target_class": {
            "const": "MODEL_CONTEXT_GROUNDED"
          }
        },
        "required": [
          "target_class"
        ]
      },
      "then": {
        "properties": {
          "target_id": {
            "enum": [
              "BM0-TUT-E01-QA0-ENTITY-ATTRIBUTE-BINDING",
              "BM0-TUT-E04-QA0-EVIDENCE-SCOPE",
              "BM0-TUT-E05-QA1G-ENTITY-ATTRIBUTE-BINDING",
              "BM0-TUT-E06-QA1G-INVENTORY-EVIDENCE-SCOPE",
              "BM0-TUT-E07-QA1G-SOURCE-MODALITY"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "target_class": {
            "const": "AGENT_STANDARDIZED"
          }
        },
        "required": [
          "target_class"
        ]
      },
      "then": {
        "properties": {
          "target_id": {
            "enum": [
              "BM0-TUT-E02-QA0-CONNECTOR-SCHEMA",
              "BM0-TUT-E08-QA1T-CONNECTOR-SCHEMA-RETRY",
              "BM0-TUT-E09-QA1T-CAPABILITY-ROUTING",
              "BM0-TUT-E10-QA1T-DESTRUCTIVE-WRITE-RECOVERY"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "target_class": {
            "const": "SYSTEM_EVAL_ONLY"
          }
        },
        "required": [
          "target_class"
        ]
      },
      "then": {
        "properties": {
          "target_id": {
            "enum": [
              "BM0-TUT-E03-QA0-INTEGRITY-COMPLETENESS",
              "BM0-TUT-E14-QA3-FULL-SET-PROJECTION-COMPLETENESS",
              "BM0-TUT-E15-QA3-METRIC-ATTRIBUTION-PROVENANCE-SEPARATION",
              "BM0-TUT-E16-QA3-DASHBOARD-FIELD-SEMANTICS-SCOPE-LOCK"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "terminal_status": {
            "const": "PASS"
          }
        },
        "required": [
          "terminal_status"
        ]
      },
      "then": {
        "properties": {
          "evidence_complete": {
            "const": true
          },
          "hard_invariant_pass": {
            "const": true
          },
          "adjudication_status": {
            "enum": [
              "NOT_REQUIRED",
              "RESOLVED"
            ]
          },
          "raw_response_fingerprint": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "evidence_receipt_fingerprint": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "terminal_status": {
            "const": "FAIL"
          }
        },
        "required": [
          "terminal_status"
        ]
      },
      "then": {
        "properties": {
          "evidence_complete": {
            "const": true
          },
          "hard_invariant_pass": {
            "const": false
          },
          "adjudication_status": {
            "enum": [
              "NOT_REQUIRED",
              "RESOLVED"
            ]
          },
          "raw_response_fingerprint": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "evidence_receipt_fingerprint": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "terminal_status": {
            "enum": [
              "NOT_EVALUABLE",
              "BLOCKED",
              "ERROR",
              "UNKNOWN"
            ]
          }
        },
        "required": [
          "terminal_status"
        ]
      },
      "then": {
        "properties": {
          "model_failure_value": {
            "type": "null"
          },
          "system_invariant_failure_value": {
            "type": "null"
          },
          "hard_invariant_pass": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "terminal_status": {
            "const": "UNKNOWN"
          }
        },
        "required": [
          "terminal_status"
        ]
      },
      "then": {
        "properties": {
          "evidence_complete": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "terminal_status": {
            "const": "ERROR"
          }
        },
        "required": [
          "terminal_status"
        ]
      },
      "then": {
        "properties": {
          "adjudication_status": {
            "enum": [
              "NOT_REQUIRED",
              "UNRESOLVED",
              "ERROR"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "target_class": {
            "const": "SYSTEM_EVAL_ONLY"
          }
        },
        "required": [
          "target_class"
        ]
      },
      "then": {
        "properties": {
          "provider_subject_id": {
            "const": "SYSTEM_SCOPE"
          },
          "model_subject_id": {
            "const": "SYSTEM_SCOPE"
          },
          "requested_model_id": {
            "const": "SYSTEM_SCOPE"
          },
          "resolved_model_or_version_id": {
            "const": "SYSTEM_SCOPE"
          },
          "endpoint_id": {
            "const": "SYSTEM_SCOPE"
          },
          "identity_certainty": {
            "const": "SYSTEM_SCOPE"
          },
          "alias_limitation": {
            "const": "NOT_APPLICABLE_SYSTEM_SCOPE"
          },
          "provider_request_id": {
            "type": "null"
          },
          "capability_mode": {
            "const": "SYSTEM_EVAL"
          },
          "provider_terminal_status": {
            "const": "NOT_APPLICABLE"
          },
          "provider_http_status": {
            "type": "null"
          },
          "usage": {
            "properties": {
              "attribution_status": {
                "enum": [
                  "NOT_APPLICABLE"
                ]
              }
            }
          },
          "latency": {
            "properties": {
              "attribution_status": {
                "enum": [
                  "NOT_APPLICABLE"
                ]
              }
            }
          },
          "cost": {
            "properties": {
              "attribution_status": {
                "enum": [
                  "NOT_APPLICABLE"
                ]
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "provider_subject_id": {
            "not": {
              "const": "SYSTEM_SCOPE"
            }
          },
          "model_subject_id": {
            "not": {
              "const": "SYSTEM_SCOPE"
            }
          },
          "requested_model_id": {
            "not": {
              "const": "SYSTEM_SCOPE"
            }
          },
          "resolved_model_or_version_id": {
            "not": {
              "const": "SYSTEM_SCOPE"
            }
          },
          "endpoint_id": {
            "not": {
              "const": "SYSTEM_SCOPE"
            }
          },
          "identity_certainty": {
            "enum": [
              "EXACT",
              "ALIAS_ONLY",
              "UNKNOWN"
            ]
          },
          "alias_limitation": {
            "enum": [
              "NONE",
              "MOVING_ALIAS_RESOLUTION_REQUIRED",
              "UNVERIFIABLE_ALIAS_DISCLOSED"
            ]
          },
