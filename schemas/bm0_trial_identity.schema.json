{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/bm0-trial-identity.schema.json",
  "title": "B2 BM0 Trial / Attempt / Model Identity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "study_id",
    "trial_id",
    "attempt_id",
    "parent_attempt_id",
    "provider_subject_id",
    "model_subject_id",
    "model_snapshot_id",
    "target_id",
    "target_class",
    "corpus_pool_id",
    "corpus_item_alias",
    "corpus_item_commitment",
    "mutation_parent_commitment",
    "prompt_template_version",
    "harness_version",
    "adapter_id",
    "adapter_version",
    "replicate_index",
    "random_seed",
    "environment_fingerprint"
  ],
  "properties": {
    "schema_version": {"const": "b2-bm0-trial-identity/v1"},
    "study_id": {"$ref": "#/$defs/identifier"},
    "trial_id": {"$ref": "#/$defs/identifier"},
    "attempt_id": {"$ref": "#/$defs/identifier"},
    "parent_attempt_id": {
      "oneOf": [
        {"$ref": "#/$defs/identifier"},
        {"type": "null"}
      ]
    },
    "provider_subject_id": {"$ref": "#/$defs/identifier"},
    "model_subject_id": {"$ref": "#/$defs/identifier"},
    "model_snapshot_id": {
      "allOf": [
        {"$ref": "#/$defs/identifier"},
        {
          "not": {
            "pattern": "^(?:[Ll][Aa][Tt][Ee][Ss][Tt]|[Dd][Ee][Ff][Aa][Uu][Ll][Tt]|[Aa][Uu][Tt][Oo]|[Nn][Oo][Tt]_[Ss][Ee][Ll][Ee][Cc][Tt][Ee][Dd])$"
          }
        }
      ]
    },
    "target_id": {"$ref": "#/$defs/identifier"},
    "target_class": {
      "enum": [
        "MODEL_DIRECT",
        "MODEL_CONTEXT_GROUNDED",
        "AGENT_STANDARDIZED",
        "SYSTEM_EVAL_ONLY"
      ]
    },
    "corpus_pool_id": {
      "enum": [
        "PUBLIC_DEVELOPMENT",
        "PUBLIC_CONTROL",
        "MUTATION",
        "PRIVATE_HIDDEN_HOLDOUT"
      ]
    },
    "corpus_item_alias": {"$ref": "#/$defs/identifier"},
    "corpus_item_commitment": {"$ref": "#/$defs/sha256"},
    "mutation_parent_commitment": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]
    },
    "prompt_template_version": {"$ref": "#/$defs/identifier"},
    "harness_version": {"$ref": "#/$defs/identifier"},
    "adapter_id": {"$ref": "#/$defs/identifier"},
    "adapter_version": {"$ref": "#/$defs/identifier"},
    "replicate_index": {"type": "integer", "minimum": 0},
    "random_seed": {"type": "integer", "minimum": 0},
    "environment_fingerprint": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"corpus_pool_id": {"const": "MUTATION"}},
        "required": ["corpus_pool_id"]
      },
      "then": {
        "properties": {
          "mutation_parent_commitment": {"$ref": "#/$defs/sha256"}
        }
      },
      "else": {
        "properties": {"mutation_parent_commitment": {"type": "null"}}
      }
    },
    {
      "if": {
        "properties": {"target_class": {"const": "SYSTEM_EVAL_ONLY"}},
        "required": ["target_class"]
      },
      "then": {
        "properties": {
          "provider_subject_id": {"const": "SYSTEM_SCOPE"},
          "model_subject_id": {"const": "SYSTEM_SCOPE"},
          "model_snapshot_id": {"const": "SYSTEM_SCOPE"}
        }
      },
      "else": {
        "properties": {
          "provider_subject_id": {"not": {"const": "SYSTEM_SCOPE"}},
          "model_subject_id": {"not": {"const": "SYSTEM_SCOPE"}},
          "model_snapshot_id": {"not": {"const": "SYSTEM_SCOPE"}}
        }
      }
    },
    {
      "if": {
        "properties": {"target_class": {"const": "MODEL_DIRECT"}},
        "required": ["target_class"]
      },
      "then": {
        "properties": {
          "target_id": {
            "enum": [
              "BM0-TUT-D01-CONSTRAINT-ADHERENCE",
              "BM0-TUT-D02-REASONING-INTEGRITY",
              "BM0-TUT-D03-CALIBRATED-ABSTENTION"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {"target_class": {"const": "MODEL_CONTEXT_GROUNDED"}},
        "required": ["target_class"]
      },
      "then": {
        "properties": {
          "target_id": {
            "enum": [
              "BM0-TUT-G01-ENTITY-ATTRIBUTE-BINDING",
              "BM0-TUT-G02-INVENTORY-EVIDENCE-SCOPE",
              "BM0-TUT-G03-SOURCE-MODALITY-PROVENANCE",
              "BM0-TUT-G04-LONG-CONTEXT-CONSTRAINT-PERSISTENCE",
              "BM0-TUT-G05-CITATION-EVIDENCE-COMPLETENESS"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {"target_class": {"const": "AGENT_STANDARDIZED"}},
        "required": ["target_class"]
      },
      "then": {
        "properties": {
          "target_id": {
            "enum": [
              "BM0-TUT-A01-CONNECTOR-SCHEMA-READBACK-RETRY",
              "BM0-TUT-A02-CAPABILITY-PERMISSION-ROUTING",
              "BM0-TUT-A03-DESTRUCTIVE-WRITE-RECOVERY",
              "BM0-TUT-A04-TOOL-SEQUENCE-GLOBAL-INTEGRITY"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {"target_class": {"const": "SYSTEM_EVAL_ONLY"}},
        "required": ["target_class"]
      },
      "then": {
        "properties": {
          "target_id": {
            "enum": [
              "BM0-TUT-S01-FULL-SET-PROJECTION-COMPLETENESS",
              "BM0-TUT-S02-TERMINAL-STATE-PERSISTENCE",
              "BM0-TUT-S03-ADAPTER-RECONCILIATION",
              "BM0-TUT-S04-CLAIM-EVIDENCE-INTEGRITY"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 192,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@+\\-/]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
