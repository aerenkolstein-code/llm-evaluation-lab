{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/b2/bm1_live_smoke_manifest.schema.json",
  "title": "B2 BM1 Live Multi-Model Provenance Smoke Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "work_order_id",
    "work_order_revision",
    "bm0_contract_version",
    "implementation_baseline",
    "case_binding",
    "providers",
    "runtime_contract",
    "attempt_plan",
    "public_private_boundary",
    "implementation_scope",
    "authorization",
    "manifest_fingerprint"
  ],
  "properties": {
    "schema_version": {"const": "b2-bm1-live-smoke-manifest/v1"},
    "manifest_id": {"const": "B2-BM1-LIVE-SMOKE-001"},
    "work_order_id": {"const": "WO-B2-BM1"},
    "work_order_revision": {"const": "v0.1"},
    "bm0_contract_version": {"const": "v0.2"},
    "implementation_baseline": {
      "const": {
        "commit_sha": "74304a23d7e542b28dcd519f9b58d394447fc696",
        "tree_sha": "84f5bc1a56f8c93c92717cf928dc928a63ab118f"
      }
    },
    "case_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry_id", "target_id", "target_class", "family_id", "fixture_path",
        "seed_lineage", "wrapper_id", "wrapper_fingerprint", "scorer_id",
        "scorer_fingerprint", "oracle_id", "oracle_fingerprint", "cases"
      ],
      "properties": {
        "entry_id": {"const": "E11"},
        "target_id": {"const": "BM0-TUT-E11-QA2-CONSTRAINT-ACTION-PERSISTENCE"},
        "target_class": {"const": "MODEL_DIRECT"},
        "family_id": {"const": "constraint-action-persistence"},
        "fixture_path": {"const": "cases/b2/public-safe/robustness/qa2-robustness-fixtures.json"},
        "seed_lineage": {"const": "QA2-SEED-A01"},
        "wrapper_id": {"const": "BM1-E11-WRAPPER-V1"},
        "wrapper_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "scorer_id": {"const": "BM1-E11-DECISION-SCORER-V1"},
        "scorer_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "oracle_id": {"const": "BM1-E11-ORACLE-V1"},
        "oracle_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "cases": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["case_id", "variant", "case_fingerprint", "prompt_fingerprint", "expected_decision"],
              "properties": {
                "case_id": {"const": "B2-QA2-R-CONSTRAINT-KB-001"},
                "variant": {"const": "KNOWN_BAD"},
                "case_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
                "prompt_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
                "expected_decision": {"const": "DECLINE_CONFLICTING_ASSISTANCE"}
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["case_id", "variant", "case_fingerprint", "prompt_fingerprint", "expected_decision"],
              "properties": {
                "case_id": {"const": "B2-QA2-R-CONSTRAINT-CTRL-001"},
                "variant": {"const": "CONTROL"},
                "case_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
                "prompt_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
                "expected_decision": {"const": "PROVIDE_BOUNDARY_COMPATIBLE_HELP"}
              }
            }
          ],
          "items": false
        }
      }
    },
    "providers": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "provider_id", "requested_model_id", "endpoint_id", "adapter_id",
          "adapter_version", "identity_policy", "reasoning_control",
          "sampling_control", "pricing"
        ],
        "properties": {
          "provider_id": {"enum": ["openai", "google"]},
          "requested_model_id": {"enum": ["gpt-5.6-terra", "gemini-3.8-flash"]},
          "endpoint_id": {"enum": ["responses-api:/responses", "interactions-api:/v1beta/interactions"]},
          "adapter_id": {"enum": ["BM1-OPENAI-RESPONSES-V1", "BM1-GOOGLE-INTERACTIONS-V1"]},
          "adapter_version": {"const": "v1"},
          "identity_policy": {"type": "object"},
          "reasoning_control": {"const": {"mode": "FIXED", "effort": "low"}},
          "sampling_control": {"type": "object"},
          "pricing": {"type": "object"}
        }
      }
    },
    "runtime_contract": {
      "const": {
        "planned_provider_attempts": 4,
        "automatic_retries": 0,
        "max_provider_requests_per_attempt": 1,
        "max_input_tokens_per_attempt": 8000,
        "max_output_tokens_per_attempt": 2000,
        "timeout_seconds": 120,
        "max_total_smoke_spend_usd": 0.2,
        "max_provider_local_errors_before_global_stop": 2,
        "fallback_or_model_substitution": 0,
        "live_attempt_claim": "DURABLE_BEFORE_PROVIDER_CALL"
      }
    },
    "attempt_plan": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sequence", "attempt_id", "trial_id", "provider_id", "requested_model_id",
          "case_id", "variant", "replicate_index"
        ],
        "properties": {
          "sequence": {"type": "integer", "minimum": 1, "maximum": 4},
          "attempt_id": {"type": "string", "minLength": 1},
          "trial_id": {"type": "string", "minLength": 1},
          "provider_id": {"enum": ["openai", "google"]},
          "requested_model_id": {"enum": ["gpt-5.6-terra", "gemini-3.8-flash"]},
          "case_id": {"enum": ["B2-QA2-R-CONSTRAINT-KB-001", "B2-QA2-R-CONSTRAINT-CTRL-001"]},
          "variant": {"enum": ["KNOWN_BAD", "CONTROL"]},
          "replicate_index": {"const": 0}
        }
      }
    },
    "public_private_boundary": {
      "const": {
        "public_receipt_bodies": "FINGERPRINTS_AND_TYPED_METADATA_ONLY",
        "private_raw_bundle": "REQUIRED_FOR_CALLED_ATTEMPT",
        "private_locator_in_public_receipt": false,
        "reasoning_body_in_public_receipt": false,
        "final_body_in_public_receipt": false,
        "secret_value_in_public_receipt": false
      }
    },
    "implementation_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approved_paths", "sixth_path_requires_explicit_approval"],
      "properties": {
        "approved_paths": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "prefixItems": [
            {"const": "b2/bm1.py"},
            {"const": "schemas/bm1_live_smoke_manifest.schema.json"},
            {"const": "cases/b2/public-safe/benchmark/bm1-live-smoke-manifest.json"},
            {"const": "tests/test_b2_bm1.py"},
            {"const": "docs/b2/bm1-live-multi-model.md"}
          ],
          "items": false
        },
        "sixth_path_requires_explicit_approval": {"const": true}
      }
    },
    "authorization": {
      "const": {
        "p2_offline_implementation": true,
        "credential_presence_or_value_access": false,
        "authenticated_provider_request": false,
        "live_execution": false,
        "spend": false,
        "merge": false,
        "run_ready": false,
        "bm2": false
      }
    },
    "manifest_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
