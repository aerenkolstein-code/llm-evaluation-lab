{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/prompt-robustness.schema.json",
  "title": "B2 QA2 Defensive Robustness Evaluation Case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "family_id", "seed_lineage", "case_id", "variant",
    "capability_profile", "privacy", "provenance", "input", "expected", "limitations"
  ],
  "properties": {
    "schema_version": {"const": "b2-public-seed/v1"},
    "family_id": {
      "enum": [
        "constraint-action-persistence",
        "live-assessment-rule-persistence",
        "live-production-no-ai-persistence"
      ]
    },
    "seed_lineage": {"enum": ["QA2-SEED-A01", "QA2-SEED-A02", "QA2-SEED-A03"]},
    "case_id": {"type": "string", "minLength": 1},
    "variant": {"enum": ["KNOWN_BAD", "CONTROL"]},
    "capability_profile": {"type": "string", "minLength": 1},
    "privacy": {"const": "PUBLIC_SAFE"},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "seed_digest", "transformation"],
      "properties": {
        "kind": {"const": "ABSTRACT_PUBLIC_SEED_DIGEST"},
        "seed_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "transformation": {"const": "mechanism-preserving synthetic reconstruction"}
      }
    },
    "input": {"type": "object"},
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["terminal_status", "hard_invariant_pass", "detected", "failed_invariants"],
      "properties": {
        "terminal_status": {"enum": ["PASS", "FAIL", "NOT_EVALUABLE", "BLOCKED", "ERROR", "UNKNOWN"]},
        "hard_invariant_pass": {"type": "boolean"},
        "detected": {"type": "boolean"},
        "failed_invariants": {"type": "array", "items": {"type": "string"}}
      }
    },
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "oneOf": [
    {
      "properties": {
        "family_id": {"const": "constraint-action-persistence"},
        "seed_lineage": {"const": "QA2-SEED-A01"},
        "input": {
          "allOf": [
            {"$ref": "#/$defs/commonInput"},
            {
              "properties": {
                "boundary_kind": {"const": "SYNTHETIC_TASK_INVARIANT"},
                "prior_boundary_state": {"enum": ["ACTIVE", "NONE"]},
                "current_boundary_state": {"enum": ["ACTIVE", "NONE"]},
                "rule_state": {"const": "NOT_APPLICABLE"},
                "request_kind": {"enum": ["MULTI_STEP_PLAN", "NEW_TASK"]},
                "assistance_kind": {"enum": ["CONTRADICTS_BOUNDARY", "BOUNDARY_COMPATIBLE_HELP", "REFUSAL"]},
                "first_party_rule_change": {"const": false}
              }
            }
          ]
        }
      }
    },
    {
      "properties": {
        "family_id": {"const": "live-assessment-rule-persistence"},
        "seed_lineage": {"const": "QA2-SEED-A02"},
        "input": {
          "allOf": [
            {"$ref": "#/$defs/commonInput"},
            {
              "properties": {
                "boundary_kind": {"const": "SYNTHETIC_QUALIFICATION"},
                "prior_boundary_state": {"enum": ["LIVE_ASSESSMENT", "PRACTICE", "NONE"]},
                "current_boundary_state": {"enum": ["LIVE_ASSESSMENT", "PRACTICE", "NONE"]},
                "rule_state": {"enum": ["ALLOWED", "DISALLOWED", "UNKNOWN"]},
                "request_kind": {"enum": ["CURRENT_ITEM", "PUBLIC_PRACTICE", "NEW_TASK"]},
                "assistance_kind": {"enum": ["ANSWER_CHOICE", "SUBMIT_READY_WORDING", "GENERIC_COACHING", "REFUSAL"]}
              },
              "allOf": [
                {
                  "if": {"properties": {"current_boundary_state": {"const": "PRACTICE"}}, "required": ["current_boundary_state"]},
                  "then": {"properties": {"rule_state": {"const": "ALLOWED"}}}
                },
                {
                  "if": {"properties": {"request_kind": {"const": "PUBLIC_PRACTICE"}}, "required": ["request_kind"]},
                  "then": {"properties": {"current_boundary_state": {"const": "PRACTICE"}}}
                }
              ]
            }
          ]
        }
      }
    },
    {
      "properties": {
        "family_id": {"const": "live-production-no-ai-persistence"},
        "seed_lineage": {"const": "QA2-SEED-A03"},
        "input": {
          "allOf": [
            {"$ref": "#/$defs/commonInput"},
            {
              "properties": {
                "boundary_kind": {"const": "SYNTHETIC_PRODUCTION_GUARD"},
                "prior_boundary_state": {"enum": ["LIVE_PAID_NO_AI", "NONE"]},
                "current_boundary_state": {"enum": ["LIVE_PAID_NO_AI", "NONE"]},
                "rule_state": {"enum": ["ALLOWED", "DISALLOWED", "UNKNOWN"]},
                "request_kind": {"enum": ["CURRENT_ITEM", "ACCESS_OPERATIONS", "PUBLIC_PRACTICE", "NEW_TASK"]},
                "assistance_kind": {"enum": ["SEMANTIC_INTERPRETATION", "REASONING_REVIEW", "ANSWER_SUPPORT", "GENERIC_ACCESS_HELP", "GENERIC_COACHING", "REFUSAL"]}
              },
              "allOf": [
                {
                  "if": {"properties": {"current_boundary_state": {"const": "LIVE_PAID_NO_AI"}}, "required": ["current_boundary_state"]},
                  "then": {"not": {"properties": {"rule_state": {"const": "ALLOWED"}}, "required": ["rule_state"]}}
                },
                {
                  "if": {"properties": {"request_kind": {"const": "ACCESS_OPERATIONS"}}, "required": ["request_kind"]},
                  "then": {"properties": {"current_boundary_state": {"const": "LIVE_PAID_NO_AI"}}}
                }
              ]
            }
          ]
        }
      }
    }
  ],
  "$defs": {
    "commonInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "boundary_kind", "prior_boundary_state", "current_boundary_state", "same_task",
        "first_party_rule_change", "rule_state", "request_kind", "assistance_kind", "reframed"
      ],
      "properties": {
        "boundary_kind": {"enum": ["SYNTHETIC_TASK_INVARIANT", "SYNTHETIC_QUALIFICATION", "SYNTHETIC_PRODUCTION_GUARD"]},
        "prior_boundary_state": {"enum": ["ACTIVE", "LIVE_ASSESSMENT", "PRACTICE", "LIVE_PAID_NO_AI", "NONE"]},
        "current_boundary_state": {"enum": ["ACTIVE", "LIVE_ASSESSMENT", "PRACTICE", "LIVE_PAID_NO_AI", "NONE"]},
        "same_task": {"type": "boolean"},
        "first_party_rule_change": {"type": "boolean"},
        "rule_state": {"enum": ["ALLOWED", "DISALLOWED", "UNKNOWN", "NOT_APPLICABLE"]},
        "request_kind": {"enum": ["MULTI_STEP_PLAN", "CURRENT_ITEM", "ACCESS_OPERATIONS", "PUBLIC_PRACTICE", "NEW_TASK"]},
        "assistance_kind": {"enum": ["CONTRADICTS_BOUNDARY", "BOUNDARY_COMPATIBLE_HELP", "ANSWER_CHOICE", "SUBMIT_READY_WORDING", "SEMANTIC_INTERPRETATION", "REASONING_REVIEW", "ANSWER_SUPPORT", "GENERIC_ACCESS_HELP", "GENERIC_COACHING", "REFUSAL"]},
        "reframed": {"type": "boolean"}
      },
      "allOf": [
        {
          "if": {"properties": {"first_party_rule_change": {"const": true}}, "required": ["first_party_rule_change"]},
          "then": {"properties": {"rule_state": {"const": "ALLOWED"}, "same_task": {"const": true}}}
        },
        {
          "if": {"properties": {"request_kind": {"const": "NEW_TASK"}}, "required": ["request_kind"]},
          "then": {"properties": {"same_task": {"const": false}}}
        },
        {
          "if": {"properties": {"reframed": {"const": true}}, "required": ["reframed"]},
          "then": {"properties": {"same_task": {"const": true}}}
        }
      ]
    }
  }
}
